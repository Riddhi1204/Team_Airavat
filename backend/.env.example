# CivicPulse Backend Environment Configuration

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+psycopg2://civicpulse:civicpulse@localhost:5433/civicpulse_db

# Security & Authentication
JWT_SECRET=civicpulse_super_secret_jwt_key_change_in_production_32bytes_min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (seeded on startup if not present)
ADMIN_DEFAULT_EMAIL=admin@civicpulse.org
ADMIN_DEFAULT_PASSWORD=Admin@123456

# Media Storage
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# External Integrations (All have resilient fallbacks)
# Geocoding
GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL=https://nominatim.openstreetmap.org

# Weather
WEATHER_PROVIDER=open-meteo

# Speech-to-text
SPEECH_PROVIDER=mock
SPEECH_API_KEY=

# Translation
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=

# AI Analysis
AI_PROVIDER=mock
AI_API_KEY=

# Infrastructure provider (OSM Overpass / Mock)
INFRASTRUCTURE_PROVIDER=overpass
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Population data provider (local / mock)
POPULATION_PROVIDER=local

# CORS
CORS_ORIGINS=*
